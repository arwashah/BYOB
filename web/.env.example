NEXT_PUBLIC_API_URL=http://localhost:8000

# Logins (optional). Supabase -> Project Settings -> API. Leave blank for guest-only.
# Real values go in web/.env.local (never committed), not in this file.
# Only the public anon / publishable key goes here; never the service_role / secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Set to "on" once Google is set up under Authentication -> Providers.
NEXT_PUBLIC_SUPABASE_GOOGLE=
